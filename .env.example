# TFS Documentation Automation MVP runtime settings

DOC_AUTOMATION_SERVER_HOST="127.0.0.1"
DOC_AUTOMATION_SERVER_PORT="7001"
DOC_AUTOMATION_SERVER_AUTO_PORT="true"
DOC_AUTOMATION_TFS_REQUEST_TIMEOUT_SECONDS="15"
DOC_AUTOMATION_TFS_VERIFY_SSL="true"
DOC_AUTOMATION_TFS_CA_BUNDLE_PATH=""
DOC_AUTOMATION_RUNNER_ENABLED="true"
DOC_AUTOMATION_RECONCILE_INTERVAL_SECONDS="30"
DOC_AUTOMATION_CONTINUOUS_MODE="false"
DOC_AUTOMATION_DISCOVERY_INTERVAL_MINUTES="5"
DOC_AUTOMATION_CONTENT_TEAM_MEMBERS_JSON="[]"
DOC_AUTOMATION_DEFAULT_CURRENT_ITERATION_ONLY="true"
DOC_AUTOMATION_EXECUTION_RUNTIME="devcontainer"
DOC_AUTOMATION_COPILOT_WSL_DISTRO="Ubuntu"
# Current persisted provider selection used by the dashboard. The devcontainer task
# picker writes it back here whenever a user makes an explicit override.
DOC_AUTOMATION_COPILOT_PROVIDER="vscode_bridge"
DOC_AUTOMATION_COPILOT_MODEL_NAME="GPT 5.6 Terra"
DOC_AUTOMATION_COPILOT_AGENT_NAME=""
DOC_AUTOMATION_COPILOT_CLI_HOST="https://github.com"
DOC_AUTOMATION_COPILOT_AUTO_LAUNCH="true"
DOC_AUTOMATION_COPILOT_PROMPT_TEMPLATE="Read `{{context_path}}`, the adjacent HTML/JSON files, and the generated capture package when present.\nStart with `capture/INSTRUCTIONS.md` and `capture/summary.md` before inspecting repository files.\nInspect referenced specs, linked pull request diffs, and reference documentation when available.\nKeep changes focused, consistent with the existing portal style, and avoid unrelated refactors.\nIf a spec is used, record the spec name/path and the section or topic that justified the change.\nFinish with a reviewer-ready summary that explains what changed and why."
DOC_AUTOMATION_COPILOT_CLI_COMMAND_TEMPLATE=""
DOC_AUTOMATION_FINAL_REPORTS_PATH="data\\reports"
DOC_AUTOMATION_COPILOT_DESKTOP_URL="https://m365.cloud.microsoft/chat"
DOC_AUTOMATION_COPILOT_REFERENCE_DOCS_PATH="/workspaces/Documentation"
DOC_AUTOMATION_COPILOT_STRICT_MODEL_SAFETY="false"
DOC_AUTOMATION_COPILOT_OPEN_WSL_REMOTE="true"
DOC_AUTOMATION_COPILOT_VSCODE_WINDOW_MODE="new"
DOC_AUTOMATION_COPILOT_VSCODE_APPLY_SETTINGS="true"
DOC_AUTOMATION_COPILOT_VSCODE_SETTINGS_PATH=""
DOC_AUTOMATION_COPILOT_VSCODE_PERMISSION_LEVEL="autopilot"
DOC_AUTOMATION_COPILOT_VSCODE_GLOBAL_AUTO_APPROVE="true"
DOC_AUTOMATION_COPILOT_VSCODE_AUTO_ACCEPT_EDITS_DELAY_MS="1000"
DOC_AUTOMATION_COPILOT_ADDITIONAL_READ_ACCESS_FOLDERS_JSON="[]"
DOC_AUTOMATION_CONTEXT_CAPTURE_ENABLED="true"
DOC_AUTOMATION_CONTEXT_CAPTURE_ROOT_MODE="parent"
DOC_AUTOMATION_CONTEXT_CAPTURE_MAX_TREE_ITEMS="50"
DOC_AUTOMATION_CONTEXT_CAPTURE_INCLUDE_PR_DIFFS="true"
DOC_AUTOMATION_CONTEXT_CAPTURE_WORKSPACE_SCAN_ROOTS_JSON="[\"/workspaces\"]"
DOC_AUTOMATION_DEFAULT_REVIEWER_DISPLAY_NAME=""
DOC_AUTOMATION_DEFAULT_REVIEWER_UNIQUE_NAME=""
DOC_AUTOMATION_DEFAULT_REVIEWER_ID=""
DOC_AUTOMATION_REVIEWER_OVERRIDES_JSON="{}"

# Optional devcontainer bootstrap inputs for TFS Git Credentials authentication.
# These are read by scripts/devcontainer-bootstrap.sh before the dashboard starts.
CONTENT_AI_TFS_HOST="tfs-product.cmf.criticalmanufacturing.com"
CONTENT_AI_HOST_GIT_CREDENTIALS_PATH=""
CONTENT_AI_TFS_GIT_USERNAME=""
CONTENT_AI_TFS_GIT_PASSWORD=""
CONTENT_AI_TFS_GIT_TOKEN=""
