{
  "name": "TFS Documentation Automation MVP",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [8000, 8001, 8010],
  "portsAttributes": {
    "8000": {
      "label": "Documentation Automation Dashboard",
      "onAutoForward": "notify"
    },
    "8001": {
      "label": "Documentation Automation Dashboard Fallback",
      "onAutoForward": "silent"
    },
    "8010": {
      "label": "TFS Autonomous Pipeline",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.terminal.activateEnvironment": false
      }
    }
  }
}
